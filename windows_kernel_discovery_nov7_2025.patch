+               (response[end] >= 'A' && response[end] <= 'F')) end++;
+        kernelInfo.current_task = std::stoull(response.substr(start, end-start), nullptr, 0);
+        std::cout << "Current task: 0x" << std::hex << kernelInfo.current_task << std::dec << "\n\n";
+    }
