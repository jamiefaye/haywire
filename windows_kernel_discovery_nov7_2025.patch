+        // PMD table
+        const pmdTablePA = Number(pudEntry & PA_MASK & ~0xFFFn);
+        console.log(`  -> PMD table at PA 0x${pmdTablePA.toString(16)}`);
+        
+        const pmdBuffer = readPage(fd, pmdTablePA);
