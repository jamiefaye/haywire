+                        resolve(pgd);
+                    } else if (msg.error) {
+                        console.log('QMP Error:', msg.error.desc);
+                        socket.end();
+                        resolve(null);
+                    }
+                } catch (e) {
+                    // Not JSON
+                }
+            }
+        });
+
+        socket.on('error', (err) => {
+            console.error('QMP connection error:', err.message);
+            reject(err);
+        });
+
+        setTimeout(() => {
+            socket.end();
+            reject(new Error('QMP timeout'));
+        }, 5000);
+    });
+}
