-    int CountKernelPointers(uint8_t* task) {
-        int count = 0;
-        // Check first 512 bytes for kernel pointers
-        for (uint64_t checkOffset = 0; checkOffset < 512; checkOffset += 8) {
-            uint64_t* ptr = (uint64_t*)(task + checkOffset);
-            if (IsKernelPointer(*ptr)) {
-                count++;
-                if (count >= 10) break;
-            }
-        }
-        return count;
-    }
