+
+        pageToPids: Object.fromEntries(
+            Array.from(output.pageToPids.entries())
+                .slice(0, 50)
+                .map(([page, pids]) => [
+                    page, // page is already a string (hex key)
+                    Array.from(pids),
+                ])
+        ),
+
+        stats: output.stats,
+    };
