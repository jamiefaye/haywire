+
+    struct stat st;
+    fstat(fd, &st);
+    memorySize = st.st_size;
+
+    memBase = mmap(nullptr, memorySize, PROT_READ, MAP_PRIVATE, fd, 0);
+    if (memBase == MAP_FAILED) {
+        std::cerr << "Failed to mmap\n";
+        close(fd);
