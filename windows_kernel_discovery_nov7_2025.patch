-
-        // Verify compilation
-        agent->ExecuteCommand("[ -x /home/ubuntu/companion_oneshot ] && echo 'COMPILE_SUCCESS'", output);
-        if (output.find("COMPILE_SUCCESS") == std::string::npos) {
-            std::cout << "Compilation failed\n";
-            return false;
-        }
