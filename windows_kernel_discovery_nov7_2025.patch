+
+    // Discover kernel structures
+    discovery.DiscoverKernel();
+
+    // Discover processes with our validated filtering
+    if (!discovery.DiscoverProcesses()) {
+        std::cerr << "Failed to discover processes" << std::endl;
+        return 1;
