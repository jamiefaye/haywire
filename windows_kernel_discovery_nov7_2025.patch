+            } else if (m.pa >= 0x140000000 && m.pa < 0x180000000) {
+                region = 'High memory (0x140000000 - 0x180000000)';
+            } else if (m.pa >= 0x180000000) {
+                region = 'Very high (>0x180000000) - Extended memory';
+            }
