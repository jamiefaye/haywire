+    bool IsValid(int pid) const { return cachedPid == pid && !pagemapData.empty(); }
+    
+    // Get cache statistics
+    size_t GetCacheSize() const { return pagemapData.size(); }
+    int GetCachedPid() const { return cachedPid; }
