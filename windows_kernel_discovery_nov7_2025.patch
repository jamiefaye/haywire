+import fs from 'fs';
+import net from 'net';
+
+const GUEST_RAM_START = 0x40000000;
+const PAGE_SIZE = 4096;
+const SWAPPER_PGD_PA = 0x136deb000;
+const PA_MASK = 0x0000FFFFFFFFFFFFn;
+const TASK_STRUCT_SIZE = 9088;
+const PID_OFFSET = 0x750;
+const COMM_OFFSET = 0x970;
