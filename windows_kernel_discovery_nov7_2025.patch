-void MemoryVisualizer::DrawFormulaBar() {
-    // Get mouse position in memory view
-    ImGuiIO& io = ImGui::GetIO();
-    ImVec2 mousePos = io.MousePos;
-    ImVec2 viewPos = memoryViewPos;
