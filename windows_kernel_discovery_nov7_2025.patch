-
-    // Run companion_oneshot with request ID and optional focus PID
-    std::stringstream cmd;
-    cmd << "cd /home/ubuntu && sudo ./companion_oneshot --once --request=0x"
-        << std::hex << requestCounter;
-
-    if (focusPid > 0) {
-        cmd << " --target=" << std::dec << focusPid;
