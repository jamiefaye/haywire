+    // Cache of VA->PA mappings per PID
+    // Map of PID -> (VA -> PA)
+    std::unordered_map<int, std::unordered_map<uint64_t, uint64_t>> pteCache;
+    
+    // Helper to align address to page boundary
+    static uint64_t AlignToPage(uint64_t addr) {
+        return addr & ~0xFFFULL;
+    }
+};
+
