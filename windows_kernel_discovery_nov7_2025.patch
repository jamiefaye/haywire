+    // Scan in 16MB chunks
+    for (uint64_t addr = 0; addr < 0x100000000; addr += 0x1000000) { // Up to 4GB
+        std::vector<uint8_t> data;
+        if (!mem.Read(addr, 4096, data) || data.size() != 4096) {
+            continue;
+        }
+        
+        // Check if this chunk has any data at all
+        bool has_data = false;
+        for (uint8_t b : data) {
