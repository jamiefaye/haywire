+        }
+    }
+
+    // Show PA ranges that ARE kernel-mapped
+    std::cout << "\n=== Kernel-Mapped PA Ranges ===\n";
+    if (!all_kernel_mapped_pages.empty()) {
+        uint64_t range_start = *all_kernel_mapped_pages.begin();
+        uint64_t range_end = range_start;
