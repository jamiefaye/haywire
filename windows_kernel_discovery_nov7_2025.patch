+int main() {
+    std::cout << "=== Checking for Duplicate PIDs ===" << std::endl;
+
+    Haywire::KernelDiscovery discovery;
+
+    if (!discovery.Initialize()) {
+        std::cerr << "Failed to initialize kernel discovery" << std::endl;
+        return 1;
