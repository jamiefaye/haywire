+pahole -C task_struct $KERNEL_DEBUG 2>/dev/null | grep -E "pid;" | sed "s/.*\/\* *\([0-9]*\).*/    'task.pid': 0x\1,/" | sed 's/0x\([0-9]*\)/0x\1/'
