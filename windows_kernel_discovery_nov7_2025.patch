+                if (range_end - range_start >= 0x100000) {  // Show ranges >= 1MB
+                    std::cout << "0x" << std::hex << range_start << " - 0x" << range_end
+                              << " (" << std::dec << (range_end - range_start + 0x1000) / 1024 / 1024
+                              << " MB)\n";
+                }
+                range_start = pa;
+                range_end = pa;
+            }
+        }
+    }
+
+    munmap(memBase, memorySize);
+    close(fd);
