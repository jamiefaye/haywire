-            return null;
-        }
-
-        this.simpleTranslationSuccesses++;
-        if (this.simpleTranslationSuccesses <= 5) {
-//             console.log(`  [SimpleTranslate] Success #${this.simpleTranslationSuccesses}: VA 0x${virtualAddr.toString(16)} -> PA 0x${physAddr.toString(16)}`);
