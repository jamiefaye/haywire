-                // In gap between regions - snap to nearest
-                uint64_t distToPrev = virtualAddr - regions[i].virtualEnd;
-                uint64_t distToNext = regions[i + 1].virtualStart - virtualAddr;
-                
-                if (distToPrev < distToNext) {
