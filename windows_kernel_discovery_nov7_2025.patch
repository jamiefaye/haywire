+                std::cout << "\nmm_struct pointer (0x930): 0x" << std::hex << mm930 << std::dec << "\n";
+            } else {
+                std::cout << "Failed to translate current_task or invalid PA\n";
+            }
+
+            munmap(memBase, memorySize);
+            close(fd);
+        }
+    }
+
+    close(qmpSocket);
+    return 0;
 }
