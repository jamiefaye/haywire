+                                gapStart = i;
+                                inGap = true;
+                            }
+                        } else {
+                            if (inGap) {
+                                gaps.push_back({gapStart, i - 1});
+                                inGap = false;
+                            }
+                        }
+                    }
+                    if (inGap) {
+                        gaps.push_back({gapStart, catInfo.page_count - 1});
+                    }
+                    
+                    // Commented out missing pages output
+                    // if (!gaps.empty()) {
+                    //     std::cout << "  Missing pages: ";
