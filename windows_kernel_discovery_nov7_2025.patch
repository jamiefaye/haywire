+void WalkPMD(uint64_t pmdBase) {
+    for (int i = 0; i < 512; i++) {
+        uint64_t pmdOffset = (pmdBase - 0x40000000) + (i * 8);
+        if (pmdOffset + 8 > memorySize) continue;
+
+        uint64_t pmd = *(uint64_t*)((uint8_t*)memBase + pmdOffset);
+        if (!(pmd & 1)) continue;
+
+        if (!(pmd & 2)) {
+            // 2MB huge page
