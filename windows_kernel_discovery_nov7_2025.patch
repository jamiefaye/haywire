+        const pudIndex = Number((virtualAddr >> 30n) & 0x1FFn);  // bits 38-30
+        const pmdIndex = Number((virtualAddr >> 21n) & 0x1FFn);  // bits 29-21
+        const pteIndex = Number((virtualAddr >> 12n) & 0x1FFn);  // bits 20-12
