+    echo "Initializing QEMU submodule..."
+    cd "$SCRIPT_DIR/.."
+    git submodule update --init --recursive
+    cd "$QEMU_DIR"
+    
+    # Apply our patch
+    echo "Applying Haywire patch..."
+    git apply "$SCRIPT_DIR/qemu-va2pa.patch"
