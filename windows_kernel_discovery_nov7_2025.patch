+                    }
+                }
+            }
+
+            if (validPudEntries > 0) {
+                validChains++;
+            }
+        }
+
+        // Need at least one valid chain to be a potential PGD
+        if (validChains < 1) {
+            if (isRealPGD || isExtractedPGD) {
+//                 console.log(`    Failed: validChains=${validChains} (need >=1), kernel=${kernelEntries}, user=${userEntries}`);
+            }
