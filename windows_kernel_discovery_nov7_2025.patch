+                                std::cout << " (kernel VA)";
+                            }
+                        }
+                    }
+                    std::cout << std::endl;
+                }
+            }
+        }
+    }
+
+    std::cout << "\nTotal 'systemd' strings found: " << found << std::endl;
+
+    munmap(memBase, fileSize);
+    close(fd);
