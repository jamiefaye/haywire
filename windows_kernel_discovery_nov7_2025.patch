+                    if (KNOWN_PROCESSES.some(known => process.name.includes(known))) {
+                        knownFound.push(process.name);
+                    }
+                }
+            }
+        }
+
+        console.log(`Found ${this.processes.size} processes`);
+        return this.processes;
+    }
