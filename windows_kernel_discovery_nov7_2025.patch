-        memFd = -1;
-        return false;
-    }
-    memSize = st.st_size;
-    
-    // Map the memory
-    memBase = mmap(nullptr, memSize, PROT_READ | PROT_WRITE, MAP_SHARED, memFd, 0);
-    if (memBase == MAP_FAILED) {
-        std::cerr << "Failed to map memory\n";
-        close(memFd);
-        memFd = -1;
-        memBase = nullptr;
-        return false;
-    }
-    
-    std::cout << "Beacon reader initialized: " << memSize / (1024*1024) << " MB mapped\n";
-    return true;
-}
