+      sharedMemoryState.canvasPtr,
+      canvasWidth,
+      canvasHeight,
+      sourceOffset,
+      displayWidth,
+      displayHeight,
+      stride,
+      format,
+      splitComponents,
+      columnMode,
+      columnWidth,
+      columnGap
+    )
