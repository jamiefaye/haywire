+                for (int j = 0; j < 16; j++) {
+                    if (comm[j] == 0) {
+                        hasNull = true;
+                        nullIdx = j;
+                        break;
+                    }
+                    if (comm[j] < 0x20 || comm[j] > 0x7E) {
+                        allPrintable = false;
+                        break;
+                    }
+                }
+
+                if (hasNull && allPrintable && nullIdx > 0 && nullIdx <= 15) {
+                    found++;
+                    if (found <= 20) {
+                        std::cout << "\nPotential PID=1 at offset 0x" << std::hex << i << std::dec;
+                        std::cout << "\n  Comm at +0x220: \"" << std::string(comm, nullIdx) << "\"";
