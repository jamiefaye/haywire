+                    }
+                    found++;
+                }
+            }
+        }
+    }
+
+    // Check known swapper_pg_dir
+    console.log('\n=== CHECKING SWAPPER_PG_DIR ===');
+    console.log('Known location: 0x136dbf000');
+    dumpPageTableEntries(memory, 0x136dbf000, 'SWAPPER_PGD', 10);
