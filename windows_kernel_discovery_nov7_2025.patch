+        perms += (flags & KernelConstants.VM_WRITE) ? 'w' : '-';
+        perms += (flags & KernelConstants.VM_EXEC) ? 'x' : '-';
+        perms += (flags & KernelConstants.VM_SHARED) ? 's' : 'p';
+        return perms;
+    }
