+    // The file starts at PA 0x40000000
+    if (pmdBase < 0x40000000 || pmdBase >= 0x40000000 + memorySize) {
+        std::cout << "  PMD base PA outside memory range (0x40000000 - 0x"
+                  << std::hex << (0x40000000 + memorySize) << ")\n";
+        return 0;
