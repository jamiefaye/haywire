+const std::vector<LinuxKernelOffsets> LinuxProcessWalker::KNOWN_OFFSET_CONFIGS = {
+    // Linux 5.15+ common layout (ARM64)
+    {0x4E8, 0x738, 0x3A0, 0x3A8, 0x520, 0x2E8, 0x320, 0x48, 0x80, 0x88, 0x90, 0x98},
