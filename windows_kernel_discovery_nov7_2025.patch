+        // Scan regions - broader to catch different configurations
+        const scanRegions = [
+            [0x70000000, 0x80000000],   // 1.75-2GB
+            [0x80000000, 0x140000000],  // 2-5GB range
+            [0x130000000, 0x140000000], // 4.75-5GB range (includes known ground truth)
+        ];
