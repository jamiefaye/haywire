-        uint64_t physAddr = flattener->GetPhysicalAddress(flatAddress);
-        if (physAddr == 0) {
-            return nullptr;  // Not mapped
-        }
-
-        // Get memory backend and return direct pointer
-        auto* backend = qemu->GetMemoryBackend();
-        if (!backend || !backend->IsAvailable()) {
