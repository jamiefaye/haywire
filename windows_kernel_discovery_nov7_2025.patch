+                uint64_t next7e0 = *(uint64_t*)(task + 0x7e0);
+                uint64_t prev7e8 = *(uint64_t*)(task + 0x7e8);
+                std::cout << "  tasks.next (0x7e0): 0x" << std::hex << next7e0 << std::dec << "\n";
+                std::cout << "  tasks.prev (0x7e8): 0x" << std::hex << prev7e8 << std::dec << "\n";
