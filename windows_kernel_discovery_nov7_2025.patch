-    // Add a PID to priority queue (scanned before background PIDs)
-    void RequestPriorityScan(uint32_t pid) {
-        std::lock_guard<std::mutex> lock(queueMutex);
-        if (scannedPIDs.find(pid) == scannedPIDs.end()) {
-            priorityQueue.push(pid);
-            cv.notify_one();
-        }
-    }
