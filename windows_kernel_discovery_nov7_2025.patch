-    // Check if it's been more than 5 seconds since last refresh
-    auto now = std::chrono::steady_clock::now();
-    auto elapsed = std::chrono::duration_cast<std::chrono::seconds>(now - lastRefreshTime).count();
-
-    return elapsed >= 5;
-}
