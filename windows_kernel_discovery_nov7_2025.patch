+    // Set default parameters
+    const {
+      sourceOffset = 0,
+      displayWidth = canvasWidth,
+      displayHeight = canvasHeight,
+      stride = displayWidth,
+      format = PixelFormat.RGB888,
+      splitComponents = false,
+      columnMode = false,
+      columnWidth = displayWidth,
+      columnGap = 0
+    } = params
