+    
+    ~HaywireClient() {
+        if (mapped_mem) {
+            munmap(mapped_mem, mapped_size);
+        }
+        if (fd >= 0) {
+            close(fd);
+        }
+    }
+    
+    bool connect() {
+        // First find beacons
+        if (!findBeaconOffset()) {
+            return false;
