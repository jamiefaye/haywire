-            if (!pudEntry || Number(pudEntry & 3n) === 0) {
-                continue;
-            }
-
-            const entryType = Number(pudEntry & 3n);
-            if (entryType === 1) {
-                // 1GB huge page - use BigInt for proper 64-bit arithmetic
-                const va = (BigInt(pgdIdx) << 39n) | (BigInt(pudIdx) << 30n);
