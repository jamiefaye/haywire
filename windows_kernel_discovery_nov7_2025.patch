+        // Scan first 50MB
+        for (let offset = 0; offset < 50 * 1024 * 1024; offset += 4) {
+            const magic = this.memory.readU32(offset);
+
+            // Prefer TMPFS and EXT4 over PROC
+            if (magic === TMPFS_MAGIC || magic === EXT4_MAGIC) {
+                return offset;
+            }
+        }
+
+        // If no TMPFS/EXT4 found, look for others
+        for (let offset = 0; offset < 50 * 1024 * 1024; offset += 4) {
+            const magic = this.memory.readU32(offset);
