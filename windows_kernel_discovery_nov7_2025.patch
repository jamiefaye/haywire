+                <td>{{ section.pages }}</td>
+              </tr>
+            </tbody>
+          </table>
+
+          <h4>Sample PTEs:</h4>
+          <table class="pte-table">
+            <thead>
+              <tr>
+                <th>Virtual</th>
+                <th>Physical</th>
+                <th>Permissions</th>
+              </tr>
+            </thead>
+            <tbody>
+              <tr v-for="pte in selectedProcessPTEs" :key="pte.va">
+                <td class="mono">{{ pte.va }}</td>
+                <td class="mono">{{ pte.pa }}</td>
+                <td>{{ pte.rwx }}</td>
+              </tr>
+            </tbody>
+          </table>
