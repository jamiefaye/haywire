+#!/usr/bin/env node
+
+import fs from 'fs';
+
+const filePath = '/tmp/haywire-vm-mem';
+const fd = fs.openSync(filePath, 'r');
+const GUEST_RAM_START = 0x40000000;
+
+// Test translation like verifyKernelPgdByTranslation does
