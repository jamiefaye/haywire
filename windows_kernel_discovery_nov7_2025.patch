-            } else if (mapleType === MAPLE_LEAF_64) {
-                nodeTypeStr = 'leaf_64 (leaf)';
-            } else if (mapleType === MAPLE_RANGE_64) {
-                nodeTypeStr = 'range_64 (internal)';
-            } else if (mapleType === MAPLE_ARANGE_64) {
