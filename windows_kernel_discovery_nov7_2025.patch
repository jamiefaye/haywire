-                    // Only log very high-scoring candidates during scan
-                    if (candidate.score > 70) {
-//                         console.log(`  High-score candidate at 0x${candidate.addr.toString(16)}: score=${candidate.score}`);
-                    }
-                }
-            }
-        }
-
-        return candidates;
-    }
