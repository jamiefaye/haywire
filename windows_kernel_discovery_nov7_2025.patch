+    if (method == METHOD_GUEST_AGENT || method == METHOD_HYBRID) {
+        return CollectMemoryMapsFromProc(pid, maps);
+    } else {
+        return CollectMemoryMapsFromKernel(pid, maps);
+    }
+}
