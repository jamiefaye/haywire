+                    memcmp(data.data() + i, "ARM64", 5) == 0) {
+                    std::cout << "  ^-- Found ARM64/aarch64 string" << std::endl;
+                    break;
+                }
+            }
+            
+            // ELF header (7F 45 4C 46)
+            if (data.size() >= 4 && data[0] == 0x7F && data[1] == 0x45 && 
