+                    pid,
+                    ptes.slice(0, 10).map(pte => ({
+                        va: `0x${pte.va.toString(16)}`,
+                        pa: `0x${pte.pa.toString(16)}`,
+                        rwx: `${pte.r ? 'r' : '-'}${pte.w ? 'w' : '-'}${pte.x ? 'x' : '-'}`,
