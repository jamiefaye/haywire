+pahole -C mm_struct /sys/kernel/btf/vmlinux | grep -E 'pgd |mm_mt |mm_users ' > /tmp/mm.txt
+pahole -C vm_area_struct /sys/kernel/btf/vmlinux | grep -E 'vm_start |vm_end |vm_flags |vm_file ' > /tmp/vma.txt
