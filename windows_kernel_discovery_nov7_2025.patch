+    std::vector<uint64_t> pagemapData;  // Raw pagemap entries
+    std::chrono::steady_clock::time_point loadTime;
+    
+    static constexpr uint64_t PAGE_SIZE = 4096;
+    static constexpr uint64_t MAX_CACHE_SIZE = 256 * 1024 * 1024; // 256MB max
