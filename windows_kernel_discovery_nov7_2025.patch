+            uint64_t pteBase = pmd & 0x0000FFFFFFFFF000ULL;
+            if (pteBase >= 0x40000000 && pteBase < 0x40000000 + memorySize) {
+                WalkPTE(pteBase);
+            }
+        }
+    }
