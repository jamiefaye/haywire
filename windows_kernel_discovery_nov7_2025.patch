+    'init', 'systemd', 'kthreadd', 'rcu_gp', 'migration',
+    'ksoftirqd', 'kworker', 'kcompactd', 'khugepaged',
+    'kswapd', 'kauditd', 'sshd', 'systemd-journal',
+    'systemd-resolved', 'systemd-networkd', 'bash',
+    'vlc', 'firefox', 'chrome', 'code', 'vim', 'emacs'
