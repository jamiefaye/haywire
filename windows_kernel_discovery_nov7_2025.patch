+#!/bin/bash
+# Extract kernel structure offsets from running VM
+# Requires VM to be booted with QGA (QEMU Guest Agent) socket
+
+set -e
+
+VM_MEM="/tmp/haywire-vm-mem"
+QGA_SOCK="/tmp/qga.sock"
