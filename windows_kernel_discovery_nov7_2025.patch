+    // Check for printable ASCII - web uses regex /^[\x20-\x7E]+$/
+    for (int i = 0; i < nullIdx; i++) {
+        if (comm[i] < 0x20 || comm[i] > 0x7E) {
+            return false;
+        }
+    }
+
+    return true;
