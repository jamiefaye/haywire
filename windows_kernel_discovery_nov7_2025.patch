+        // Scan broader regions for more candidates
+        const scanRegions = [
+            [0x02000000, 0x10000000],  // 32MB - 256MB
+            [0x20000000, 0x30000000],  // 512MB - 768MB
+            [0x40000000, 0x50000000],  // 1GB - 1.25GB region
+            [0x60000000, 0x70000000],  // 1.5GB - 1.75GB
+        ];
