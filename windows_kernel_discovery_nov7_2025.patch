+    const status = isMapped ? '✓ MAPPED' : '✗ NOT MAPPED';
+    console.log(`  ${sym.name.padEnd(20)} at VA 0x${sym.va.toString(16)} ${status}`);
+    
+    if (isMapped) mappedCount++;
+    else unmappedCount++;
+}
+
