+    | 'data'           // Initialized data
+    | 'bss'            // Uninitialized data
+    | 'heap'           // Heap allocation
+    | 'stack'          // Stack
+    | 'guard'          // Guard page
+    | 'shared_lib'     // Shared library
+    | 'page_table'     // Page table (PGD/PUD/PMD/PTE)
